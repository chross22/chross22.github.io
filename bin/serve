#!/usr/bin/env bash
# Preview the site locally at http://localhost:4000
#
# Pins the toolchain this site actually needs:
#   - Ruby 3.3  (the `github-pages` gem requires Ruby < 4.0)
#   - UTF-8 locale (Jekyll's SCSS converter fails on curly quotes without it)
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="/opt/homebrew/opt/ruby@3.3/bin:$PATH"
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
exec bundle exec jekyll serve --livereload "$@"
